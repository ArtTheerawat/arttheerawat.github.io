# ============================================================================
# Theedeck — environment variables (example)
# Copy this file to `.env.local` for local dev, or set these in your Vercel
# project settings → Environment Variables for production.
#
# Supabase project credentials live in: Supabase Dashboard → Project Settings
# → API. `Project URL` and `anon public` key are safe to expose to the browser.
# The `service_role` key is SECRET — never put it in the browser or commit it.
# ============================================================================

# ── Supabase (required for the hidden-tasks cloud sync) ────────────────────
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon (public) key, e.g. eyJhbGciOi... (NOT the service_role key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Optional: site origin used by the sign-out redirect default ───────────
# Set to your deployed URL in production (e.g. https://theedeck.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Already in use (leave as-is) ───────────────────────────────────────────
# Server-side only key used by /api/usage (Vercel env var, never committed).
# OPENROUTER_API_KEY=

# ── Authorization for /api/usage (security) ────────────────────────────────
# Comma-separated list of emails allowed to view AI usage, e.g.
#   USAGE_ALLOWED_EMAILS=you@gmail.com
# This allowlist is REQUIRED (fail-closed): if unset/blank, EVERYONE is denied
# (403) — set it to your email to unlock the usage endpoint. Guests → 401,
# signed-in non-owners → 403, owner → data.

# ── Owner email for mutating the GLOBAL hidden-task set ─────────────────────
# The hidden set is now global (everyone sees the same hides). Only this owner
# may hide/unhide/clear. Keep it in sync with the RLS allow-list in
# supabase/migrations/0002_make_hidden_tasks_global.sql ('PLEASE-REPLACE@example.com').
# Comma-separated if multiple owners. If unset, ANY signed-in user may write.
#   NEXT_PUBLIC_HIDDEN_ALLOWED_EMAILS=<you@gmail.com>

# ── AI Study Assistant (SYSTEM 8) ───────────────────────────────────────────
# Live chat route /api/assistant calls the 9arm model (same provider the morning
# brief cron uses). Server-side only — NEVER put these in NEXT_PUBLIC_. The
# assistant is gated behind Supabase auth + USAGE_ALLOWED_EMAILS (owner only).
#
# If ASSISTANT_API_KEY is blank, the assistant still works in deterministic mode
# for direct questions ("วันนี้มีอะไร?", "งานไหนควรทำก่อน?") answered by code
# with zero tokens; AI-only questions show a clear "AI ไม่พร้อม" message.
#
#   ASSISTANT_API_KEY=            # 9arm key (see alternative below)
#   ASSISTANT_BASE_URL=https://gateway.9arm.co/v1
#   ASSISTANT_MODEL=deepseek-v4-flash-0731
#   ASSISTANT_FALLBACK_MODEL=qwen3.8-27b-fp8
#
# The 9arm key lives in the machine's hermes env (~/AppData/Local/hermes/.env).
# To wire it here for local dev only (never commit), copy those values into a
# local .env.local, or set them as Vercel env vars for deployment.