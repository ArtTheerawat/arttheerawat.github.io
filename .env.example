# ============================================================================
# Theedeck — environment variables (example)
# Copy this file to `.env.local` for local dev, or set these in your Vercel
# project settings → Environment Variables for production.
#
# Supabase project credentials live in: Supabase Dashboard → Project Settings
# → API. `Project URL` and `anon public` key are safe to expose to the browser.
# The `service_role` key is SECRET — never put it in the browser or commit it.
# ============================================================================

# ── Supabase (required for the hidden-tasks cloud sync) ────────────────────
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon (public) key, e.g. eyJhbGciOi... (NOT the service_role key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Optional: site origin used by the sign-out redirect default ───────────
# Set to your deployed URL in production (e.g. https://theedeck.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Already in use (leave as-is) ───────────────────────────────────────────
# Server-side only key used by /api/usage (Vercel env var, never committed).
# OPENROUTER_API_KEY=